{
  "name": "macro-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write src tests contracts *.json *.ts *.html",
    "data:demo": "python -m pipeline.build --demo",
    "data:update": "python -m pipeline.build",
    "data:validate": "tsx scripts/validate-data.ts"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@fontsource/manrope": "^5.2.0",
    "@fontsource/newsreader": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.1.0",
    "typescript": "~5.9.0",
    "vue-tsc": "^3.0.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "tsx": "^4.20.0",
    "eslint": "^9.35.0",
    "@eslint/js": "^9.35.0",
    "typescript-eslint": "^8.42.0",
    "eslint-plugin-vue": "^10.4.0",
    "prettier": "^3.6.0"
  }
}
