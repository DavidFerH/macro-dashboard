# Only the Python acquisition process reads this value. Never use VITE_ for secrets.
FRED_API_KEY=
# Set true only after documenting permission to publish the Shiller data.
# Also configure this repository variable in GitHub Actions for public updates.
SHILLER_PUBLICATION_APPROVED=false
# Optional local override; otherwise the importer fetches the official workbook.
# This file alone does not authorize publication.
SHILLER_FILE=
